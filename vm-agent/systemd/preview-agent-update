#!/bin/bash
# Download latest preview-agent from the preview server.
# Called by systemd ExecStartPre before starting the agent.
# PREVIEW_SERVER_URL is set in /etc/preview-agent.env by the server during VM creation.

set -euo pipefail

ENV_FILE="/etc/preview-agent.env"
if [ -f "$ENV_FILE" ]; then
    source "$ENV_FILE"
fi

AGENT_URL="${PREVIEW_SERVER_URL:-https://api.preview-mr.com}/api/internal/agent/download"
AGENT_BIN="/usr/local/bin/preview-agent"

# Download new version
if curl -sf -o "${AGENT_BIN}.new" "$AGENT_URL"; then
    chmod +x "${AGENT_BIN}.new"
    mv "${AGENT_BIN}.new" "$AGENT_BIN"
    echo "Agent updated from $AGENT_URL"
else
    # If download fails and we have an existing binary, continue with it
    if [ -x "$AGENT_BIN" ]; then
        echo "Agent download failed, using existing binary"
    else
        echo "ERROR: No agent binary available"
        exit 1
    fi
fi
