[Unit]
Description=Druploy Worker (arq)
After=network.target docker.service druploy.service
Requires=docker.service

[Service]
Type=simple
User=druploy
Group=druploy
WorkingDirectory=/home/druploy/www/previews/server/preview-manager
Environment="PATH=/home/druploy/www/previews/server/preview-manager/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/druploy/www/previews/server/preview-manager/venv/bin/arq app.workers.WorkerSettings
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=druploy-worker

# Give running deploy jobs time to finish on restart (15 minutes)
TimeoutStopSec=900

# Security
PrivateTmp=true

[Install]
WantedBy=multi-user.target
