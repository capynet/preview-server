[Unit]
Description=Preview Manager Worker (arq)
After=network.target docker.service preview-manager.service
Requires=docker.service

[Service]
Type=simple
User=preview-manager
Group=preview-manager
WorkingDirectory=/home/preview-manager/www/previews/server/preview-manager
Environment="PATH=/home/preview-manager/www/previews/server/preview-manager/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/preview-manager/www/previews/server/preview-manager/venv/bin/arq app.workers.WorkerSettings
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=preview-worker

# Give running deploy jobs time to finish on restart (15 minutes)
TimeoutStopSec=900

# Security
PrivateTmp=true

[Install]
WantedBy=multi-user.target
