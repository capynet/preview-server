# Infrastructure services for Preview Manager
# Managed by Ansible — do not edit manually

services:
  postgres:
    image: postgres:17-alpine
    container_name: preview-postgres
    restart: unless-stopped
    volumes:
      - pgdata:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: preview_manager
      POSTGRES_USER: preview_manager
      POSTGRES_PASSWORD: "{{ postgres_password }}"
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U preview_manager"]
      interval: 5s
      retries: 5

  valkey:
    image: valkey/valkey:8-alpine
    container_name: preview-valkey
    restart: unless-stopped
    volumes:
      - valkeydata:/data
    ports:
      - "127.0.0.1:6379:6379"
    command: valkey-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru

  tinyproxy:
    image: kalaksi/tinyproxy
    container_name: preview-tinyproxy
    restart: unless-stopped
    ports:
      - "0.0.0.0:3128:8888"
    environment:
      AUTH_USER: "{{ tinyproxy_user }}"
      AUTH_PASSWORD: "{{ tinyproxy_password }}"
      ALLOWED_NETWORKS: "0.0.0.0/0"
      DISABLE_VIA_HEADER: "yes"
      MAX_CLIENTS: "1000"

volumes:
  pgdata:
  valkeydata:
