# Preview Manager Configuration
# Generated by Ansible - {{ ansible_date_time.iso8601 }}

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# GitLab Integration
GITLAB_URL={{ gitlab_url }}

# Database
DATABASE_URL=postgresql://preview_manager:{{ postgres_password }}@localhost:5432/preview_manager
VALKEY_URL=redis://localhost:6379

# Auth
SECRET_KEY={{ secret_key }}
GITLAB_OAUTH_CLIENT_ID={{ gitlab_oauth_client_id }}
GITLAB_OAUTH_CLIENT_SECRET={{ gitlab_oauth_client_secret }}
GOOGLE_OAUTH_CLIENT_ID={{ google_oauth_client_id | default('') }}
GOOGLE_OAUTH_CLIENT_SECRET={{ google_oauth_client_secret | default('') }}
FRONTEND_URL={{ frontend_url | default('https://' + domain) }}

# Domain configuration
BASE_DOMAIN={{ domain }}
PREVIEW_DOMAIN={{ domain }}
API_URL=https://api.{{ domain }}
OAUTH_REDIRECT_URI_BASE=https://api.{{ domain }}/api/auth/callback
INVITATION_FROM_EMAIL=Druploy <noreply@{{ domain }}>

# GitLab Webhooks
GITLAB_WEBHOOK_SECRET={{ gitlab_webhook_secret }}

# Resend (email invitations)
RESEND_API_KEY={{ resend_api_key | default('') }}

# Uvicorn
UVICORN_WORKERS={{ uvicorn_workers | default(2) }}

# Docker Compose
DOCKER_NETWORK=druploy-network
DRUPAL_BASE_IMAGE=druploy-drupal
DOCKER_REGISTRY={{ docker_registry | default('') }}
DEFAULT_PHP_VERSION=8.3
DEFAULT_MYSQL_VERSION=8.0

# Warm Pool
WARM_POOL_SIZE=1

# Hetzner Cloud
HETZNER_API_TOKEN={{ hetzner_api_token }}
HETZNER_LOCATION={{ hetzner_location | default('fsn1') }}
HETZNER_SNAPSHOT_ID={{ hetzner_snapshot_id | default(0) }}
HETZNER_SSH_PRIVATE_KEY_PATH=/home/druploy/.ssh/druploy-vm
HETZNER_SSH_PUBLIC_KEY={{ ssh_public_key_content.content | b64decode | trim }}

# Storage backend: "s3" or "storagebox"
STORAGE_BACKEND={{ storage_backend | default('s3') }}

# Hetzner Object Storage (S3)
HETZNER_S3_ENDPOINT={{ hetzner_s3_endpoint }}
HETZNER_S3_ACCESS_KEY={{ hetzner_s3_access_key }}
HETZNER_S3_SECRET_KEY={{ hetzner_s3_secret_key }}
HETZNER_S3_BUCKET={{ hetzner_s3_bucket | default('preview-manager') }}

# Hetzner Storage Box (SFTP)
STORAGEBOX_HOST={{ storagebox_host | default('') }}
STORAGEBOX_PORT={{ storagebox_port | default(23) }}
STORAGEBOX_USER={{ storagebox_user | default('') }}
STORAGEBOX_SSH_KEY_PATH=/home/druploy/.ssh/druploy-vm

# Composer proxy (internal tinyproxy)
COMPOSER_PROXY_URL=http://{{ tinyproxy_user }}:{{ tinyproxy_password }}@{{ ansible_host }}:3128

# Seed Data
SEED_ADMIN_EMAIL={{ seed_admin_email }}
SEED_ADMIN_NAME={{ seed_admin_name }}
SEED_ADMIN_PASSWORD_HASH={{ seed_admin_password_hash }}
SEED_TEST_EMAIL={{ seed_test_email }}
SEED_TEST_NAME={{ seed_test_name }}
SEED_TEST_GOOGLE_ID={{ seed_test_google_id }}
SEED_ORG_SLUG={{ seed_org_slug }}
SEED_ORG_NAME={{ seed_org_name }}
SEED_ORG_COLOR={{ seed_org_color }}
SEED_ORG_GITLAB_URL={{ seed_org_gitlab_url }}
SEED_ORG_GITLAB_TOKEN={{ seed_org_gitlab_token }}
SEED_PROJECT_SLUG={{ seed_project_slug }}
SEED_PROJECT_NAME={{ seed_project_name }}
SEED_PROJECT_GITLAB_ID={{ seed_project_gitlab_id }}
SEED_PROJECT_GITLAB_PATH={{ seed_project_gitlab_path }}
SEED_PROJECT_GITLAB_URL={{ seed_project_gitlab_url }}
SEED_PROJECT_GITLAB_BRANCH={{ seed_project_gitlab_branch }}
SEED_PROJECT_ENV_VARS={{ seed_project_env_vars }}
SEED_EMAIL_DOMAIN={{ seed_email_domain }}
SEED_EMAIL_DOMAIN_ROLE={{ seed_email_domain_role }}
