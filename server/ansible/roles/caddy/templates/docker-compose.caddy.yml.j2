services:
  caddy:
    build:
      context: .
      dockerfile: Dockerfile.caddy
    image: druploy-caddy:latest
    container_name: druploy-caddy
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
      # Admin API: bind to loopback only. The backend reaches it via
      # localhost:2019 on the host; it must NOT be exposed to the internet
      # (unauthenticated full reverse-proxy control).
      - "127.0.0.1:2019:2019"
    volumes:
      - caddy_data:/data
      - caddy_config:/config
      - /opt/preview-landing:/landing:ro
    environment:
      CLOUDFLARE_API_TOKEN: "{{ cloudflare_api_token }}"
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"

volumes:
  caddy_data:
  caddy_config:
