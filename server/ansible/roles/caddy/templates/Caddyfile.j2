{
	admin 0.0.0.0:2019
}

# API backend
api.{{ domain }} {
	reverse_proxy host.docker.internal:8000
}

# Frontend app (root domain)
{{ domain }} {
	# Docs live on druploy.com — redirect any /docs request from the app domain
	# to the public site so the canonical URL is druploy.com/docs/*.
	@docs path /docs /docs/*
	redir @docs https://druploy.com{uri} permanent

	reverse_proxy host.docker.internal:3000
}

# Public website
druploy.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	root * /landing
	file_server
}

# Wildcard TLS cert + routing managed via Admin API.
# The Python app inserts per-preview direct routes (position 0) via Admin API
# so they are evaluated BEFORE this fallback.
*.{{ domain }} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy host.docker.internal:8000
}
